[Unit]
Description=NAVBOT operational monitoring and administrator alerts
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/sbin/navbot-monitor.py
TimeoutStartSec=120
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/navbot/operations

